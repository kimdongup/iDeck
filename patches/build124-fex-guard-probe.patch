diff --git a/Source/Windows/WOW64/Module.cpp b/Source/Windows/WOW64/Module.cpp
index 5c7dd8686..79b56a3df 100644
--- a/Source/Windows/WOW64/Module.cpp
+++ b/Source/Windows/WOW64/Module.cpp
@@ -1924,6 +1924,23 @@ bool BTCpuResetToConsistentStateImpl(EXCEPTION_POINTERS* Ptrs) {
 
   auto& Fault = Thread->CurrentFrame->SynchronousFaultData;
   *Exception = FEX::Windows::HandleGuestException(Fault, *Exception, WowContext.Eip, WowContext.Eax, WowContext.Ecx);
+  /* HandleGuestException writes a guest RIP. wine's host_ptr32() subtracts the
+   * WoW window base from ExceptionAddress on the way to the 32-bit record, so a
+   * relocated iOS window would wrap 0x6DBC6732. Addresses this module puts in
+   * the record stay host-side. Base == 0 keeps the upstream identity map. */
+  if (GuestWindow::Base) {
+    const auto HostIfGuest = [](uint64_t Addr) -> uint64_t {
+      return Addr < GuestWindow::Size ? GuestWindow::ToHost(Addr) : Addr;
+    };
+    Exception->ExceptionAddress =
+        reinterpret_cast<void*>(HostIfGuest(reinterpret_cast<uint64_t>(Exception->ExceptionAddress)));
+    if (Exception->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && Exception->NumberParameters >= 2) {
+      Exception->ExceptionInformation[1] = HostIfGuest(Exception->ExceptionInformation[1]);
+    }
+  }
+  LogMan::Msg::DFmt("guest-signal code: {:X} addr: {:X} signal: {} trap: {}", Exception->ExceptionCode,
+                    reinterpret_cast<uint64_t>(Exception->ExceptionAddress), static_cast<unsigned>(Fault.Signal),
+                    static_cast<unsigned>(Fault.TrapNo));
   if (Exception->ExceptionCode == EXCEPTION_SINGLE_STEP) {
     WowContext.EFlags &= ~(1 << FEXCore::X86State::RFLAG_TF_RAW_LOC);
   }
